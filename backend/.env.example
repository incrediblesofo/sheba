# ------------------------------------------------------------------ #
# Sheba Sound — Backend Environment Variables Configuration
# ------------------------------------------------------------------ #

# 1. Supabase Database (PostgreSQL)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Transaction pooler)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. Supabase Storage (For storing songs, covers, avatars)
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Use service_role key for backend so it has full permission to write to buckets:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_STORAGE_BUCKET=music

# 3. Security & Django Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# 4. Frontend URL (Your Vercel deployment URL or localhost)
FRONTEND_URL=https://sheba.vercel.app

# 5. Optional: Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 6. Chapa Payment Gateway (https://dashboard.chapa.co)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=

# 7. Optional: Telebirr Payment Gateway
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PUBLIC_KEY=

