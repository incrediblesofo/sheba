# Sheba Sound — Frontend Environment Variables

# Base URL of the API.
# When deployed together on Vercel with vercel.json multi-services, leave as /api
VITE_API_BASE_URL=/api

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Chapa Payment Gateway Public Key (from https://dashboard.chapa.co)
VITE_CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxx

